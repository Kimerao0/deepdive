{
  "name": "deepdive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "author": "Alessandro Ceruti",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "8.65.0",
    "vitest": "catalog:"
  },
  "scripts": {
    "dev:next": "pnpm --filter @deepdive/next dev",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  }
}
